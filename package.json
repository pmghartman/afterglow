{
  "name": "@phosphorus/afterglow",
  "version": "0.0.0",
  "description": "Stream a Windows host's apps as low-latency H.264: afterglow, a host driven over one loopback link, and glow, a GameStream client",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmghartman/afterglow.git"
  },
  "homepage": "https://github.com/pmghartman/afterglow#readme",
  "bugs": "https://github.com/pmghartman/afterglow/issues",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "bun test",
    "test:host": "cargo test --manifest-path host/Cargo.toml",
    "test:e2e": "cargo build --release --manifest-path host/Cargo.toml && AFTERGLOW_BIN=host/target/release/afterglow bun test test/e2e",
    "fmt": "biome check --write .",
    "lint": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
