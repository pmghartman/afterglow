{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!build", "!host", "!**/*.md"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "bracketSameLine": true } },
  "json": { "formatter": { "enabled": true } },
  "linter": { "enabled": false },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
